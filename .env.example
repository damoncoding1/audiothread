SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=audio-files
SUPABASE_STORAGE_USE_PUBLIC_URLS=true
SUPABASE_DATABASE_CONNECTION_STRING=

# Release and ports
IMAGE_TAG=local
RELEASE_ID=local
API_HOST_PORT=5270
APP_PORT=8080
FRONTEND_HOST_PORT=8081
VITE_API_BASE_URL=http://localhost:5270
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# Per-deploy configuration
AUDIO_PROCESSING_MODE=Optimized
AUDIO_PROCESSING_MAX_CONCURRENT_JOBS=2
AUDIO_PROCESSING_QUEUE_CAPACITY=8
AUDIO_SUMMARIZATION_MODEL_THREADS=4
AUDIO_SUMMARIZATION_TIMEOUT_SECONDS=900
AUDIO_NOISE_REDUCTION_MODEL_THREADS=2
AUDIO_NOISE_REDUCTION_TIMEOUT_SECONDS=900
HOST_SHUTDOWN_TIMEOUT=00:00:30
CORS_ALLOWED_ORIGIN_0=http://localhost:5173
CORS_ALLOWED_ORIGIN_1=http://localhost:4173
CORS_ALLOWED_ORIGIN_2=http://localhost:8081
